{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$(locale charmap 2>/dev/null)\" = UTF-8 ] || [ -z \"$CLAUDE_ENV_FILE\" ] || echo 'export LANG=C.UTF-8 LC_ALL=C.UTF-8' >> \"$CLAUDE_ENV_FILE\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.github/hooks/check_main_up_to_date.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.github/hooks/check_metadata_yml.py\""
          }
        ]
      }
    ]
  }
}
